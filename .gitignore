# Generated optimization outputs
output/*
!output/breakout/
!output/momentum/
!output/portfolio/
!output/trend/

# Strategy output roots should only expose round_N directories.
output/breakout/*
!output/breakout/round_[0-9]/
!output/breakout/round_[0-9][0-9]/
!output/breakout/round_[0-9][0-9][0-9]/
output/breakout/archive/

output/momentum/*
!output/momentum/round_[0-9]/
!output/momentum/round_[0-9][0-9]/
!output/momentum/round_[0-9][0-9][0-9]/
output/momentum/archive/

output/portfolio/*
!output/portfolio/round_[0-9]/
!output/portfolio/round_[0-9][0-9]/
!output/portfolio/round_[0-9][0-9][0-9]/
output/portfolio/archive/

output/trend/*
!output/trend/round_[0-9]/
!output/trend/round_[0-9][0-9]/
!output/trend/round_[0-9][0-9][0-9]/
output/trend/archive/

